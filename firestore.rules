rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isOwner(hackathonId) {
      return request.auth != null 
        && exists(/databases/$(database)/documents/hackathons/$(hackathonId))
        && get(/databases/$(database)/documents/hackathons/$(hackathonId)).data.ownerId == request.auth.uid;
    }

    function isJudge(hackathonId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/hackathons/$(hackathonId)/judges/$(request.auth.uid));
    }
    
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /hackathons/{hackathonId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(hackathonId);
      
      match /teams/{teamId} {
        allow read: if true;
        allow write: if isOwner(hackathonId) || isJudge(hackathonId);
      }
      
      match /settings/{docId} {
        allow read: if true;
        allow write: if isOwner(hackathonId);
      }
      
      match /judges/{uid} {
        allow read: if true;
        allow write: if isOwner(hackathonId);
      }
    }
  }
}
